                        <form onsubmit="handleContactSubmit(event)">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-uppercase">Họ và Tên</label>
                                <input type="text" class="form-control rounded-0" required placeholder="Nguyễn Văn A">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-uppercase">Email</label>
                                <input type="email" class="form-control rounded-0" required placeholder="example@email.com">
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-uppercase">Nội dung tin nhắn</label>
                                <textarea class="form-control rounded-0" rows="5" required placeholder="Nhập nội dung cần hỗ trợ..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-minimal">Gửi Tin Nhắn</button>
                        </form>
                    </div>

                    <div class="col-md-6">
                        <div class="bg-light p-4 mb-4">
                            <h5 class="fw-bold text-uppercase fs-6 mb-3">Thông Tin Cửa Hàng</h5>
                            <p class="small text-muted mb-2"><i class="bi bi-geo-alt me-2 text-dark"></i> 123 Đường Lê Lợi, Quận 1, TP. Hồ Chí Minh</p>
                            <p class="small text-muted mb-2"><i class="bi bi-telephone me-2 text-dark"></i> +84 (0) 123 456 789</p>
                            <p class="small text-muted mb-2"><i class="bi bi-envelope me-2 text-dark"></i> support@minimalstore.com</p>
                            <p class="small text-muted mb-0"><i class="bi bi-clock me-2 text-dark"></i> 09:00 - 21:00 (Thứ 2 - Chủ Nhật)</p>
