                        </div>
                    </div>
                </div>

                <!-- Category Filters -->
                <div class="d-flex flex-wrap gap-2 mb-4 border-bottom pb-3">
                    <button class="filter-btn active" onclick="setCategory('all', this)">Tất cả</button>
                    <button class="filter-btn" onclick="setCategory('tshirt', this)">Áo Phông</button>
                    <button class="filter-btn" onclick="setCategory('jacket', this)">Áo Khoác</button>
