<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MINIMAL - Fashion Store</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --bg-primary: #ffffff;
                --bg-secondary: #f8f9fa;
                --text-main: #111111;
                --text-muted: #6c757d;
                --accent-black: #000000;
                --border-color: #e5e5e5;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                color: var(--text-main);
                background-color: var(--bg-primary);
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* Navbar & Typography */
            .navbar-brand {
                font-weight: 800;
                letter-spacing: 4px;
                font-size: 1.5rem;
                color: var(--accent-black) !important;
            }

            .nav-link {
                color: var(--text-main) !important;
                font-weight: 500;
                text-transform: uppercase;
                font-size: 0.85rem;
                letter-spacing: 1.5px;
                padding: 0.5rem 1rem !important;
                transition: opacity 0.2s ease;
            }

                .nav-link:hover, .nav-link.active {
                    opacity: 0.6;
                    border-bottom: 2px solid var(--accent-black);
                }

            /* Buttons */
            .btn-minimal {
                background-color: var(--accent-black);
                color: #ffffff;
                border: 1px solid var(--accent-black);
                border-radius: 0;
                padding: 10px 24px;
                font-size: 0.85rem;
                letter-spacing: 1px;
                text-transform: uppercase;
                font-weight: 600;
                transition: all 0.3s ease;
            }

                .btn-minimal:hover {
                    background-color: #ffffff;
                    color: var(--accent-black);
                }

            .btn-minimal-outline {
                background-color: transparent;
                color: var(--accent-black);
                border: 1px solid var(--accent-black);
                border-radius: 0;
                padding: 10px 24px;
                font-size: 0.85rem;
                letter-spacing: 1px;
                text-transform: uppercase;
                font-weight: 600;
                transition: all 0.3s ease;
            }

                .btn-minimal-outline:hover {
                    background-color: var(--accent-black);
                    color: #ffffff;
                }

            /* Product Card */
            .product-card {
                border: none;
                background: transparent;
                transition: transform 0.3s ease;
            }

                .product-card .img-wrapper {
                    position: relative;
                    overflow: hidden;
                    background-color: #f3f3f3;
                    padding-top: 125%; /* 4:5 Aspect Ratio */
                }

                .product-card img {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.5s ease;
                }

                .product-card:hover img {
                    transform: scale(1.05);
                }

                .product-card .badge-tag {
                    position: absolute;
                    top: 12px;
                    left: 12px;
                    background-color: var(--accent-black);
                    color: white;
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    padding: 4px 8px;
                    border-radius: 0;
                    letter-spacing: 1px;
                }

            .product-title {
                font-size: 0.95rem;
                font-weight: 600;
                margin-top: 12px;
                margin-bottom: 4px;
                text-decoration: none;
                color: var(--text-main);
                display: block;
            }

            .product-price {
                font-size: 0.9rem;
                color: var(--text-muted);
                font-weight: 500;
            }

            /* Filter Pills */
            .filter-btn {
                border: none;
                background: transparent;
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 6px 16px;
                color: var(--text-muted);
                transition: all 0.2s ease;
                cursor: pointer;
            }

                .filter-btn.active, .filter-btn:hover {
                    color: var(--accent-black);
                    font-weight: 700;
                    border-bottom: 2px solid var(--accent-black);
                }

            /* SPA Sections Toggle */
            .page-section {
                display: none;
                opacity: 0;
                transition: opacity 0.3s ease-in-out;
            }

                .page-section.active {
                    display: block;
                    opacity: 1;
                }

            /* Hero Banner */
            .hero-banner {
                background-color: #f1f1f1;
                padding: 100px 0;
                text-align: center;
            }

            .hero-title {
                font-size: 3rem;
                font-weight: 800;
                letter-spacing: 2px;
                margin-bottom: 20px;
            }

            /* Footer */
            footer {
                background-color: var(--accent-black);
                color: #ffffff;
                margin-top: auto;
            }

                footer a {
                    color: #aaaaaa;
                    text-decoration: none;
                    transition: color 0.2s;
                }

                    footer a:hover {
                        color: #ffffff;
                    }

            .form-control-minimal {
                background-color: transparent;
                border: 1px solid #444;
                color: #fff;
                border-radius: 0;
            }

                .form-control-minimal:focus {
                    background-color: transparent;
                    border-color: #fff;
                    color: #fff;
                    box-shadow: none;
                }

            /* Cart Page Styling */
            .cart-table img {
                width: 70px;
                height: 90px;
                object-fit: cover;
            }

            .quantity-btn {
                border: 1px solid var(--border-color);
                background: #fff;
                width: 32px;
                height: 32px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
            }
    </style>
</head>
<body>

