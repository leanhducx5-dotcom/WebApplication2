            <div class="container">
                <a class="navbar-brand" href="#" onclick="navigateTo('home')">MINIMAL</a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" id="nav-home" href="#" onclick="navigateTo('home')">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="nav-shop" href="#" onclick="navigateTo('shop')">Sản phẩm</a>
