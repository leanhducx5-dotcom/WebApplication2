                    </div>
                </div>
            </div>
        </section>

        <section id="section-shop" class="page-section">
            <div class="container py-5">
                <div class="row mb-4 align-items-center">
                    <div class="col-md-6">
                        <h1 class="h3 fw-bold text-uppercase mb-2">Cửa Hàng</h1>
                        <p class="text-muted small mb-0">Tất cả sản phẩm thiết kế tối giản dành cho bạn</p>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <div class="input-group">
                            <input type="text" id="search-input" class="form-control rounded-0 border-end-0" placeholder="Tìm kiếm sản phẩm..." onkeyup="filterProducts()">
